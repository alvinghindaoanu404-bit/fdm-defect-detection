# Jarvis settings. Copy this file to ".env" and fill in what you want to use.
# Everything is optional except a brain (section 1). Lines starting with # are ignored.

# ---------------------------------------------------------------------------
# 1. The brain: Claude (recommended) or a model on this computer
# ---------------------------------------------------------------------------
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise the local model.
JARVIS_LLM=auto

# Claude. Get a key at https://platform.claude.com (pay per use).
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
# How hard Claude thinks: low | medium | high. Lower is faster and cheaper.
ANTHROPIC_EFFORT=medium
# If Claude's safety filters decline a request, let Anthropic retry it on its
# recommended fallback model instead of failing. Set to false to turn off.
ANTHROPIC_FALLBACKS=true

# A model on this computer via Ollama, LM Studio or llama.cpp (free, private,
# less capable). The model must support tool calling.
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=

# ---------------------------------------------------------------------------
# 2. About you
# ---------------------------------------------------------------------------
JARVIS_USER_NAME=
# e.g. Europe/London, America/New_York, Asia/Manila. Blank = this computer's zone.
JARVIS_TIMEZONE=

# ---------------------------------------------------------------------------
# 3. Email (IMAP + SMTP)
# ---------------------------------------------------------------------------
# Use an APP PASSWORD, never your normal password.
#   Gmail:  turn on 2-Step Verification, then https://myaccount.google.com/apppasswords
#   iCloud: https://account.apple.com > Sign-In and Security > App-Specific Passwords
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# approve = Jarvis only drafts; you press Send. (Keep this.)
# auto    = Jarvis may send by itself. Read "Safety" in the README first.
EMAIL_SEND_MODE=approve
# Only needed if your provider is not Gmail, iCloud, Yahoo or Fastmail:
#EMAIL_IMAP_HOST=
#EMAIL_IMAP_PORT=993
#EMAIL_SMTP_HOST=
#EMAIL_SMTP_PORT=465

# ---------------------------------------------------------------------------
# 4. Calendar (read-only)
# ---------------------------------------------------------------------------
# One or more private iCal links, separated by commas.
#   Google: Calendar settings > your calendar > "Secret address in iCal format"
#   iCloud: share the calendar as a Public Calendar and copy the link
CALENDAR_ICS_URLS=

# ---------------------------------------------------------------------------
# 5. WhatsApp (unofficial; read the README warning before enabling)
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
# Talk to Jarvis by messaging yourself in WhatsApp.
WHATSAPP_CHAT_WITH_SELF=true
# Send new-email alerts, event reminders and the daily briefing to that chat.
WHATSAPP_NOTIFY=true

# ---------------------------------------------------------------------------
# 6. Internet
# ---------------------------------------------------------------------------
# auto = Claude's built-in web search when the brain is Claude, otherwise DuckDuckGo.
# Other values: anthropic | duckduckgo | brave | off
WEB_SEARCH=auto
# Optional, more reliable than DuckDuckGo for local models: https://brave.com/search/api/
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# 7. Background checks
# ---------------------------------------------------------------------------
# How often to look for new email and upcoming events.
WATCH_INTERVAL_MINUTES=5
# Remind me this many minutes before an event starts.
EVENT_REMINDER_MINUTES=30
# Daily briefing time in 24h format, e.g. 07:30. Blank = no automatic briefing.
DAILY_BRIEF_TIME=

# ---------------------------------------------------------------------------
# 8. Using it from your phone
# ---------------------------------------------------------------------------
# 127.0.0.1 = only this computer. 0.0.0.0 = any device on your Wi-Fi, which
# REQUIRES a long random JARVIS_TOKEN (think of it as the password).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_TOKEN=
